# ============ USTD Token 环境变量配置 ============

# 目标网络：shasta / nile / mainnet（测试网请先填 shasta）
TRON_NETWORK=shasta

# 部署钱包私钥（部署与转账签名使用，请勿提交真实私钥到仓库）
DEPLOYER_PRIVATE_KEY=

# 总发行量（枚，部署时指定。示例：100000000 = 1 亿枚）
INITIAL_SUPPLY=100000000

# WAB3 合约地址（部署成功后自动写入 deployment.json，也可手动回填）
WAB3_CONTRACT=

# owner / 收款监控地址（监听器判定收入/支出方向使用；为空时取部署者地址）
WAB3_OWNER=

# 监听器监控地址列表（逗号分隔，可选；为空时使用 WAB3_OWNER）
WAB3_MONITOR_ADDRESSES=

# TRONGrid API Key（可选，https://www.trongrid.io 免费申请；不配置时免费额度 3 rps，配置后大幅提升限额）
TRONGRID_API_KEY=

# 后端服务端口（默认 3001）
PORT=3001

# ============ USTD 价格配置 ============
# USTD 初始价格（USDT 计价，示例：0.99 = 1 USTD = 0.99 USDT）
# 价格可通过 POST /api/wab3/price 动态调整，调整后持久化到 price-state.json
WAB3_INITIAL_PRICE=0.99

# ============ USDT Explorer 可选配置 ============

# 以太坊交易记录查询 API Key（https://etherscan.io 免费注册，不配置则 ETH 交易记录不可用）
ETHERSCAN_API_KEY=
